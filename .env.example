# ============================================================
# Agentic AI — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
# ============================================================

# ── LLM Configuration ────────────────────────────────────────
# The system works WITHOUT an LLM key.
# ML models run analysis; LLM only enhances explanations.
# If blank, system falls back to deterministic report generation.

LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Alternative: Google Gemini ────────────────────────────────
# LLM_PROVIDER=google
# LLM_API_KEY=
# LLM_MODEL=gemini-1.5-flash

# ── Application Settings ──────────────────────────────────────
APP_NAME=Industrial Equipment Health Monitor
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ── Dataset Paths (relative to project root) ─────────────────
ARCHIVE_PATH=archive
DATA_PROCESSED_PATH=data/processed
DATA_FEATURES_PATH=data/features
MODELS_PATH=models
REPORTS_PATH=reports/figures
KNOWLEDGE_BASE_PATH=knowledge_base

# ── Model Configuration ───────────────────────────────────────
FAULT_MODEL_PATH=models/fault_model.pkl
ANOMALY_MODEL_PATH=models/anomaly_model.pkl
FEATURE_SCALER_PATH=models/feature_scaler.pkl

# ── Health Score Thresholds (configurable rules) ──────────────
HEALTH_HEALTHY_MIN=90
HEALTH_NORMAL_MIN=70
HEALTH_DEGRADED_MIN=40
# Below HEALTH_DEGRADED_MIN = Critical (0-39)

# ── FastAPI Settings ──────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
