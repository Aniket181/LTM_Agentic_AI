# ─────────────────────────────────────────────────────────────
#  .env.example — Environment Variable Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────

# ─── LLM Provider ────────────────────────────────────────────
# Google Gemini (recommended for this project)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# OpenAI (alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic (alternative)
ANTHROPIC_API_KEY=

# ─── LangSmith (optional — for LangGraph tracing) ────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agentic-industrial-health

# ─── Database ─────────────────────────────────────────────────
# PostgreSQL (Phase 13 — production backend)
DATABASE_URL=postgresql://user:password@localhost:5432/industrial_health

# SQLite (Phase 1-12 — local development)
SQLITE_DB_PATH=./data/app.db

# ─── Vector Database (RAG — Phase 11) ────────────────────────
VECTOR_DB_BACKEND=faiss
# Options: faiss | chroma | qdrant

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma_db

# Qdrant (if using remote)
QDRANT_URL=
QDRANT_API_KEY=

# ─── API Configuration (Phase 13) ────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# ─── Streamlit Dashboard (Phase 14) ──────────────────────────
DASHBOARD_HOST=localhost
DASHBOARD_PORT=8501

# ─── Model Configuration ──────────────────────────────────────
MODELS_DIR=./models
RANDOM_SEED=42

# ─── Dataset Paths ────────────────────────────────────────────
BEARING_DATA_DIR=./data/raw/bearing_dataset
CMAPSS_DATA_DIR=./data/raw/cmapss

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
